# RookHub-Build des Lichess-Opening-Explorers: Server + Import-Werkzeuge in einem schlanken Image.
# Basis-Images per Digest gepinnt (Stand 2026-10-26, Multi-Arch-Index-Digest aus
# `docker buildx imagetools inspect <image>`); erneuern siehe README-rookhub.md „Basis-Images“.
# rust:1-trixie
FROM rust:1-trixie@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS build
RUN apt-get update && apt-get install -y --no-install-recommends libclang-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/app/import-pgn/target \
    set -a && . ./.env && set +a \
    && cargo build --release \
    && cargo build --release --manifest-path import-pgn/Cargo.toml \
    && mkdir -p /out \
    && cp target/release/lila-openingexplorer import-pgn/target/release/import-lichess \
          import-pgn/target/release/import-masters /out/

# debian:trixie-slim
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
# megatools aus dem Debian-Paket (trixie: 1.11.5, signiertes Archiv) für MEGA-Links von Hand
# (`megatools dl`); python3 für rookhub/lumbra-fetch (Lumbra-Download-Bereich seit 2026-10).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libssl3 zstd 7zip megatools python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
COPY rookhub/ /usr/local/bin/
# Git-Stand des Builds (Buildbefehl in README-rookhub.md). Erst hier, damit ein neuer Stand keine
# der Schichten davor neu baut.
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
ENV EXPLORER_LOG=lila_openingexplorer=info
EXPOSE 9002
CMD ["lila-openingexplorer", "--bind", "0.0.0.0:9002"]
